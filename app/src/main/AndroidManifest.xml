<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!--
      Package visibility (Android 11+): without these, Play’s “Open with” chooser
      often only sees the browser and cannot detect YouTube / Spotify, etc.
    -->
    <queries>
        <package android:name="com.tailscale.ipn" />
        <!-- Core media apps (Play button prefers these when installed) -->
        <package android:name="com.google.android.youtube" />
        <package android:name="org.schabi.newpipe" />
        <package android:name="com.spotify.music" />
        <package android:name="com.soundcloud.android" />
        <package android:name="com.vimeo.android.videoapp" />
        <package android:name="tv.twitch.android.app" />
        <!-- Resolve any https/http viewer for the chooser extras -->
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <category android:name="android.intent.category.BROWSABLE" />
            <data android:scheme="https" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <category android:name="android.intent.category.BROWSABLE" />
            <data android:scheme="http" />
        </intent>
    </queries>

    <application
        android:name=".FreshRssApp"
        android:allowBackup="false"
        android:fullBackupContent="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.FreshRss"
        android:usesCleartextTraffic="true">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.FreshRss"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Home-screen widget: icon + unread + last updated (app-driven refresh) -->
        <receiver
            android:name=".widget.FreshRssGlanceWidgetReceiver"
            android:exported="true"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/freshrss_widget_info" />
        </receiver>
    </application>
</manifest>
